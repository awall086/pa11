<?xml version="1.0" encoding="UTF-8"?>
 
<PropertyList>

	<fx>
 
		<crank>
			<name>engstart</name>
			<path>Sounds/engstart.wav</path>
			<property>engines/engine/cranking</property>
			<position>
				<x>-1.0</x>
				<y>0.0</y>
				<z>0.0</z>
			</position>
			<volume>
				<offset>0.4</offset>
			</volume>
		</crank>

		<crank>
			<name>crank</name>
			<mode>looped</mode>
			<path>Sounds/cranking.wav</path>
			<condition>
				<property>engines/engine/cranking</property>
				<not>
					<property>engines/engine/running</property>
				</not>
			</condition>
			<position>
				<x>-1.0</x>
				<y>0.0</y>
				<z>0.0</z>
			</position>
			<volume>
				<offset>0.5</offset>
			</volume>
		</crank>

		<crank>
			<name>cough</name>
			<path>Sounds/coughing.wav</path>
			<property>engines/engine/running</property>
			<position>
				<x>-1.0</x>
				<y>0.0</y>
				<z>0.0</z>
			</position>
			<volume>
				<offset>0.3</offset>
			</volume>
		</crank>

		<engine>
			<name>engine</name>
			<mode>looped</mode>
			<path>/Aircraft/pa11/Sounds/Sounds_Engine_Continental-O200A.wav</path>
			<property>/engines/engine/running</property>
			<volume>
			  <property>/engines/engine/mp-osi</property>
			  <factor>0.027777</factor> 
			  <!-- these values of min and max are unlikely to be relevant,
				   because the MAP is unlikely to go below 5" or above 28".
				   Also note that propeller noise is additional to engine
				   noise, rather like an <offset>.
					 -->
			  <min>0.30</min>
			  <max>2.0</max>
			</volume>
			<pitch>
				<property>/engines/engine/rpm</property>
				<factor>0.0010</factor>
				<min>0.0</min>
				<max>2.5</max>
				<offset>0.01</offset>
			</pitch>
		</engine>

        <engine-cut>
            <name>engine-cut</name>
            <mode>once</mode>
            <path>Sounds/engine-cut.wav</path>
            <condition>
                <and>
                    <not>
                        <property>/engines/engine/running</property>
                    </not>
                    <greater-than>
                        <property>/engines/engine/egt-degf</property>
                        <value>800</value>
                    </greater-than>
                </and>
            </condition>
            <volume>
                <offset>0.3</offset>
            </volume>
            <reference-dist>5.0</reference-dist>
            <max-dist>200.0</max-dist>
        </engine-cut>

		<propeller>
			<name>propeller</name>
			<mode>looped</mode>
			<path>Sounds/prop.wav</path>
			<condition>
				<greater-than>
					<property>/engines/engine/rpm</property>
					<value>10</value>
				</greater-than>
			</condition>
			<volume>
				<property>/engines/engine/rpm</property>
				<factor>0.0001</factor>
				<max>0.25</max>
			</volume>
			<pitch>
				<property>/engines/engine/rpm</property>
				<factor>0.0015</factor>
				 <min>0.0</min>
				 <max>2.0</max>
				 <offset>0.01</offset>
			</pitch>
		</propeller>

		<rumble>
			<name>rumble</name>
			<mode>looped</mode>
			<path>Sounds/rumble.wav</path>
			<condition>
				<or>
					<property>gear/gear[0]/wow</property>
					<property>gear/gear[1]/wow</property>
					<property>gear/gear[2]/wow</property>
				</or>
			<!-- <property>sim/current-view/internal</property> -->
			</condition>
			<position>
				<x>1.0</x>
				<y>0.0</y>
				<z>-1.5</z>
			</position>
			<volume>
				<property>velocities/groundspeed-kt</property>
				<type>log</type>
				<factor>0.25</factor>
			</volume>
		</rumble>

		<squeal>
			<name>squeal</name>
			<path>Sounds/squeal.wav</path>
			<condition>
				<and>
					<or>
						<property>gear/gear[0]/wow</property>
						<property>gear/gear[1]/wow</property>
						<property>gear/gear[2]/wow</property>
					</or>
					<less-than>
						<property>velocities/vertical-speed-fps</property>
						<value>-0.05</value>
					</less-than>
				</and>
			</condition>
			<position>
				<x>1.0</x>
				<y>0.0</y>
				<z>-1.5</z>
			</position>
			<volume>
				<property>velocities/groundspeed-kt</property>
				<factor>0.01</factor>
				<max>1.0</max>
			</volume>
			<volume>
				<internal>dt_stop</internal>
				<factor>0.1</factor>
				<max>1.0</max>
			</volume>
			<pitch>
				<property>velocities/groundspeed-kt</property>
				<factor>0.0025</factor>
				<offset>1.2</offset>
			</pitch>
		</squeal>
 
        <right-door-opening>
            <name>right-door-opening</name>
            <mode>once</mode>
            <path>Sounds/door-opening.wav</path>
            <condition>
                <greater-than>
                    <property>/sim/model/door-positions/rightDoor/position-norm</property>
                    <value>0.02</value>
                </greater-than>
            </condition>
            <position>
                <x>0.75</x>
                <y>-0.6</y>
                <z>-0.35</z>
            </position>
            <reference-dist>1.5</reference-dist>
            <max-dist>50.0</max-dist>
        </right-door-opening>

        <right-door-closing>
            <name>right-door-closing</name>
            <mode>once</mode>
            <path>Sounds/door-closing.wav</path>
            <condition>
                <less-than>
                    <property>/sim/model/door-positions/rightDoor/position-norm</property>
                    <value>0.50</value>
                </less-than>
            </condition>
            <position>
                <x>0.75</x>
                <y>-0.6</y>
                <z>-0.35</z>
            </position>
            <reference-dist>1.5</reference-dist>
            <max-dist>50.0</max-dist>
        </right-door-closing>

        <left-window-opening>
            <name>left-window-opening</name>
            <mode>once</mode>
            <path>Sounds/window-opening.wav</path>
            <condition>
                <greater-than>
                    <property>/sim/model/door-positions/leftWindow/position-norm</property>
                    <value>0.4</value>
                </greater-than>
            </condition>
            <position>
                <x>2.58</x>
                <y>0.72</y>
                <z>0.22</z>
            </position>
            <volume>
                <factor>0.7</factor>
            </volume>
            <reference-dist>0.2</reference-dist>
            <max-dist>50.0</max-dist>
        </left-window-opening>

        <left-window-closing>
            <name>left-window-closing</name>
            <mode>once</mode>
            <path>Sounds/window-closing.wav</path>
            <condition>
                <less-than>
                    <property>/sim/model/door-positions/leftWindow/position-norm</property>
                    <value>0.5</value>
                </less-than>
            </condition>
            <position>
                <x>2.58</x>
                <y>0.72</y>
                <z>0.22</z>
            </position>
            <volume>
                <factor>0.55</factor>
            </volume>
            <reference-dist>0.2</reference-dist>
            <max-dist>50.0</max-dist>
        </left-window-closing>

        <right-window-opening>
            <name>right-window-opening</name>
            <mode>once</mode>
            <path>Sounds/window-opening.wav</path>
            <condition>
                <greater-than>
                    <property>/sim/model/door-positions/rightWindow/position-norm</property>
                    <value>0.4</value>
                </greater-than>
            </condition>
            <position>
                <x>2.58</x>
                <y>-0.72</y>
                <z>0.22</z>
            </position>
            <volume>
                <factor>0.7</factor>
            </volume>
            <reference-dist>0.2</reference-dist>
            <max-dist>50.0</max-dist>
        </right-window-opening>

        <right-window-closing>
            <name>right-window-closing</name>
            <mode>once</mode>
            <path>Sounds/window-closing.wav</path>
            <condition>
                <less-than>
                    <property>/sim/model/door-positions/rightWindow/position-norm</property>
                    <value>0.5</value>
                </less-than>
            </condition>
            <position>
                <x>2.58</x>
                <y>-0.72</y>
                <z>0.22</z>
            </position>
            <volume>
                <factor>0.55</factor>
            </volume>
            <reference-dist>0.2</reference-dist>
            <max-dist>50.0</max-dist>
        </right-window-closing>

        <switch>
            <name>click-magneto-forward</name>
            <mode>once</mode>
            <path>Sounds/keys2.wav</path>
            <condition>
                <property>/sim/model/pa11/sound/click-magneto-forward</property>
            </condition>
            <position>
                <x> 2.3660</x>
                <y>-0.3700</y>
                <z> 0.3500</z>
            </position>
            <volume>
                <factor>4.0</factor>
            </volume>
            <reference-dist>1.2</reference-dist>
            <max-dist>5.0</max-dist>
        </switch>

        <switch>
            <name>click-magneto-back</name>
            <mode>once</mode>
            <path>Sounds/keys.wav</path>
            <condition>
                <property>/sim/model/pa11/sound/click-magneto-back</property>
            </condition>
            <position>
                <x> 2.3660</x>
                <y>-0.3700</y>
                <z> 0.3500</z>
            </position>
            <volume>
                <factor>4.0</factor>
            </volume>
            <reference-dist>1.2</reference-dist>
            <max-dist>5.0</max-dist>
        </switch>

        <switch>
            <name>click-primer-out</name>
            <mode>once</mode>
            <path>Sounds/primer-out.wav</path>
            <condition>
                <property>/controls/engines/engine/primer-lever</property>
            </condition>
            <volume>
                <factor>3.32</factor>
            </volume>
            <position>
                <x>-0.3660</x>
                <y>0.3700</y>
                <z>-0.3500</z>
            </position>
            <reference-dist>0.2</reference-dist>
            <max-dist>5.0</max-dist>
        </switch>

        <switch>
            <name>click-primer-in</name>
            <mode>once</mode>
            <path>Sounds/primer-in.wav</path>
            <condition>
                <not>
                    <property>/controls/engines/engine/primer-lever</property>
                </not>
            </condition>
            <volume>
                <factor>3.32</factor>
            </volume>
            <position>
                <x>-0.3660</x>
                <y>0.3700</y>
                <z>-0.3500</z>
            </position>
            <reference-dist>0.2</reference-dist>
            <max-dist>5.0</max-dist>
        </switch>

        <switch>
            <name>click-fuel-valve</name>
            <mode>once</mode>
            <path>Sounds/click.wav</path>
            <condition>
                <property>/controls/fuel/fuel-on</property>
            </condition>
            <volume>
                <factor>3.32</factor>
            </volume>
            <position>
                <x>-0.3660</x>
                <y>0.3700</y>
                <z>-0.3500</z>
            </position>
            <reference-dist>0.2</reference-dist>
            <max-dist>5.0</max-dist>
        </switch>
		
	</fx>
 
</PropertyList>
