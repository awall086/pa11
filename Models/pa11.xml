	<!-- Right Door -->

    <animation>
        <type>rotate</type>
        <object-name>RDoor</object-name>
        <object-name>RDoor_ext</object-name>
        <object-name>RDoor-ext-handle-m</object-name>
        <object-name>RDoor-int-handle</object-name>
                
        <property alias="../../params/doors/right/property"/>
        <interpolation>
            <entry>
                <ind>0.0</ind>
                <dep>0.0</dep>
            </entry>
            <entry>
                <ind>0.25</ind>
                <dep>0</dep>
            </entry>
            <entry>
                <ind>1</ind>
                <dep>-170.0</dep>
            </entry>
        </interpolation>
		<center>
			<x-m>2.0483</x-m>
			<y-m>0.3892</y-m>
			<z-m>-0.2166</z-m>
		</center>
		<axis>
			<x>1.0</x>
			<y>0.0</y>
			<z>0.0</z>
		</axis>
    </animation>

    <animation>
        <type>pick</type>
        <object-name>RDoor-ext-handle-m</object-name>
        <visible>true</visible>
        <action>
            <button>0</button>
            <repeatable>false</repeatable>
            <binding>
                <command>nasal</command>
                <script>pa11.rightDoor.toggle();</script>
            </binding>
        </action>
        <hovered>
            <binding>
                <command>set-tooltip</command>
                <tooltip-id>door-handle-l</tooltip-id>
                <label>Open/Close Door</label>
            </binding>
        </hovered>
    </animation>

   <animation>
        <type>rotate</type>
        <object-name>RDoor-ext-handle-m</object-name>                
        <property alias="../../params/doors/right/property"/>
        <interpolation>
            <entry>
                <ind>0.0</ind>
                <dep>0.0</dep>
            </entry>
            <entry>
                <ind>0.25</ind>
                <dep>80.0</dep>
            </entry>
<!--            <entry>
                <ind>1.0</ind>
                <dep>80.0</dep>
            </entry> -->
        </interpolation>
		<center>
			<x-m>2.0183</x-m>
			<y-m>0.3978</y-m>
			<z-m>0.1003</z-m>
		</center>
		<axis>
			<x>0.0</x>
			<y>1.0</y>
			<z>0.0</z>
		</axis>
    </animation>

    <animation>
        <type>pick</type>
        <object-name>RDoor-int-handle</object-name>
        <condition>
            <equals>
                <property>/sim/model/door-positions/rightDoor/opened</property>
                <value>0.0</value>
            </equals>
        </condition>
        <visible>true</visible>
        <action>
            <button>0</button>
            <repeatable>false</repeatable>
            <binding>
                <command>nasal</command>
                <script>pa11.rightDoor.toggle();</script>
            </binding>
        </action>
        <hovered>
            <binding>
                <command>set-tooltip</command>
                <tooltip-id>door-handle-int-r</tooltip-id>
                <label>Open Door</label>
            </binding>
        </hovered>
    </animation> 
    <animation>
        <type>pick</type>
        <object-name>RDoor</object-name>
        <condition>
            <equals>
                <property>/sim/model/door-positions/rightDoor/opened</property>
                <value>1.0</value>
            </equals>
        </condition>
        <visible>true</visible>
        <action>
            <button>0</button>
            <repeatable>false</repeatable>
            <binding>
                <command>nasal</command>
                <script>pa11.rightDoor.toggle();</script>
            </binding>
        </action>
        <hovered>
            <binding>
                <command>set-tooltip</command>
                <tooltip-id>door-close-R</tooltip-id>
                <label>Close Door</label>
            </binding>
        </hovered>
    </animation>

   <animation>
        <type>rotate</type>
        <object-name>RDoor-int-handle</object-name>                
        <property alias="../../params/doors/right/property"/>
        <interpolation>
            <entry>
                <ind>0.0</ind>
                <dep>0.0</dep>
            </entry>
            <entry>
                <ind>0.15</ind>
                <dep>80.0</dep>
            </entry>
<!--            <entry>
                <ind>1.0</ind>
                <dep>80.0</dep>
            </entry> -->
        </interpolation>
		<center>
			<x-m>2.0183</x-m>
			<y-m>0.3391</y-m>
			<z-m>0.1006</z-m>
		</center>
		<axis>
			<x>0.0</x>
			<y>1.0</y>
			<z>0.0</z>
		</axis>
