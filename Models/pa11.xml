<?xml version="1.0"?>

<PropertyList>

    <path>pa11.ac</path>

    <params>
        <doors>
            <right>
                <property>sim/multiplay/generic/float[0]</property>
            </right>
        </doors>
		<windows>
            <right>sim/multiplay/generic/float[1]</right>
            <left>sim/multiplay/generic/float[2]</left>
        </windows>
	</params>


	<!--		magneto switch		-->
	 <animation>
		<type>knob</type>
		<object-name>Magneto</object-name>
		<action>
			<binding>
				<command>property-adjust</command>
				<property>/controls/switches/magnetos</property>
				<factor>1</factor>
				<min>0</min>
				<max>3</max>
			</binding>
		</action>
		<!--   <increase>
			 <binding>
			   <command>nasal</command>
			   <script>c152.click("magneto-forward")</script>
			 </binding>
		   </increase>
		   <decrease>
			 <binding>
			   <command>nasal</command>
			   <script>c152.click("magneto-back")</script>
			 </binding>
		   </decrease> -->
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>magneto-switch</tooltip-id>
				<label>Magnetos: %s</label>
				<property>controls/switches/magnetos</property>
				<mapping>nasal</mapping>
				<script>
					var m = arg[0];
					if (m == 1) return 'RIGHT';
					if (m == 2) return 'LEFT';
					if (m == 3) return 'BOTH';
					return 'OFF';
				</script>
			</binding>
		</hovered>
	 </animation>
	 <animation>
		<name>mags-key</name>
		<type>rotate</type>
		<object-name>Magneto</object-name>
		<property>/controls/switches/magnetos</property>
		<factor>30</factor>
		<center>
			<x-m>1.88329</x-m>
			<y-m>-0.350494</y-m>
			<z-m>-0.01125</z-m>
		</center>
		<axis>
			<x>0</x>
			<y>-1</y>
			<z>0</z>
		</axis>
	</animation>

	<!--	fuel valve		-->
	<animation>
		<type>rotate</type>
		<object-name>fuel-valve</object-name>
		<property>/controls/fuel/fuel-on</property>
		<factor>-90</factor>
		<axis>
			<x>0.0</x>
			<y>1.0</y>
			<z>0.0</z>
		</axis>
		<center>
			<x-m>1.57576</x-m>
			<y-m>-0.330053</y-m>
			<z-m>-0.101746</z-m>
		</center>
	</animation>
	<animation>
	   <type>pick</type>
	   <object-name>fuel-valve</object-name>
	   <visible>true</visible>
	   <action>
		 <button>0</button>
		 <repeatable>false</repeatable>
		 <binding>
		   <command>property-toggle</command>
			<property>/controls/fuel/fuel-on</property>
		 </binding>
	   </action>
	   <hovered>
		<binding>
		  <command>set-tooltip</command>
		  <tooltip-id>Fuel Valve</tooltip-id>
		  <label>Fuel Valve: %s</label>
		  <mapping>on-off</mapping>
		<property>/controls/fuel/fuel-on</property>
	   </binding>
	   </hovered>
	</animation>        

