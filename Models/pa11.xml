	<!-- Left Aileron -->
	<animation>
		<type>rotate</type>
		<object-name>Laileron</object-name>
		<property>controls/flight/aileron</property>
		<interpolation>
			<entry>
				<ind>-1.0</ind>
				<dep>-18</dep>
