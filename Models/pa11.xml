	<!--		magneto switch		-->
	 <animation>
		<type>knob</type>
		<object-name>Magneto</object-name>
		<action>
			<binding>
				<command>property-adjust</command>
				<property>/controls/switches/magnetos</property>
				<factor>1</factor>
				<min>0</min>
				<max>3</max>
			</binding>
		</action>
			<increase>
				<binding>
					<command>nasal</command>
					<script>pa11.click("magneto-forward")</script>
				</binding>
			</increase>
			<decrease>
				<binding>
					<command>nasal</command>
					<script>pa11.click("magneto-back")</script>
				</binding>
			</decrease>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>magneto-switch</tooltip-id>
				<label>Magnetos: %s</label>
				<property>controls/switches/magnetos</property>
				<mapping>nasal</mapping>
				<script>
					var m = arg[0];
					if (m == 1) return 'RIGHT';
					if (m == 2) return 'LEFT';
					if (m == 3) return 'BOTH';
					return 'OFF';
				</script>
			</binding>
		</hovered>
	 </animation>
